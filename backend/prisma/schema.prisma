// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(auto()) @map("_id") @db.ObjectId
  name                 String         @unique
  phone                String?
  bio                  String?
  // Real phone number (User.phone holds the password, see AuthGuard)
  phoneNumber          String?
  // Last 10 digits of phoneNumber, used to match contacts. Unique in code, not by index.
  phoneKey             String?
  about                String?
  avatarFileId         String?        @db.ObjectId
  // Illustrated avatar "<style>:<seed>"; mutually exclusive with avatarFileId
  avatarPreset         String?
  lastSeenAt           DateTime?
  typingConversationId String?        @db.ObjectId
  typingAt             DateTime?
  conversationIds      String[]       @db.ObjectId
  conversations        Conversation[] @relation(fields: [conversationIds], references: [id])
  messages             Message[]

  @@map("users")
}

model Conversation {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String?
  type             String // "DM" | "GROUP"
  createdAt        DateTime  @default(now())
  createdBy        String    @db.ObjectId
  participants_ids String[]  @map("userIds") @db.ObjectId
  // Disappearing messages: new messages expire this many seconds after sending (unset/0 = off)
  disappearSeconds Int?
  users            User[]    @relation(fields: [participants_ids], references: [id])
  messages         Message[]

  @@map("conversations")
}

model Message {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  content            String       @default("")
  type               String       @default("TEXT") // "TEXT" | "IMAGE" | "FILE" | "SYSTEM"
  fileId             String?      @db.ObjectId
  createdAt          DateTime     @default(now())
  senderId           String       @db.ObjectId
  sender             User         @relation(fields: [senderId], references: [id])
  conversationId     String       @db.ObjectId
  conversation       Conversation @relation(fields: [conversationId], references: [id])
  status             Json
  replyToId          String?      @db.ObjectId
  editedAt           DateTime?
  deletedForEveryone Boolean?
  deletedFor         String[]     @db.ObjectId
  reactions          Json? // { [userId]: emoji }
  starredBy          String[]     @db.ObjectId
  forwarded          Boolean?
  // SYSTEM messages only: "screenshot" | "disappearing"
  systemKind         String?
  // Set when sent in a chat with disappearing messages on; hidden and later deleted after this
  expiresAt          DateTime?
  // Snaps (view-once photos)
  viewOnce           Boolean?
  viewSeconds        Int?
  openedBy           String[]     @db.ObjectId

  @@index([fileId])
  @@index([conversationId, createdAt])
  @@index([expiresAt])
  @@map("messages")
}

model File {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  mimeType   String
  size       Int
  kind       String // "IMAGE" | "FILE"
  data       Bytes
  uploadedBy String   @db.ObjectId
  createdAt  DateTime @default(now())

  @@map("files")
}

model Contact {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String   @db.ObjectId
  name        String
  phoneNumber String
  phoneKey    String
  createdAt   DateTime @default(now())

  @@index([ownerId])
  @@map("contacts")
}

model Block {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId   String   @db.ObjectId
  blockedId String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([ownerId, blockedId])
  @@map("blocks")
}

model ChatPref {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  conversationId String    @db.ObjectId
  pinned         Boolean?
  archived       Boolean?
  mutedUntil     DateTime?
  clearedAt      DateTime?
  pinnedAt       DateTime?

  @@unique([userId, conversationId])
  @@map("chat_prefs")
}

model Status {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  type       String // "TEXT" | "IMAGE"
  text       String?
  background String?
  fileId     String?  @db.ObjectId
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  viewerIds  String[] @db.ObjectId

  @@index([userId])
  @@map("statuses")
}
