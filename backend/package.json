{
  "name": "natter-server",
  "version": "1.0.0",
  "description": "Natter chat server — NestJS, Prisma, MongoDB",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "docker:up": "docker compose up --build",
    "docker:up:bot": "BOT_MODE=true docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "docker:seed": "docker exec natter_api npm run seed",
    "start:dev": "nest start --watch",
    "start:dev:bot": "BOT_MODE=true nest start --watch",
    "start:prod": "node dist/main",
    "build": "nest build",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.3.1",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}