MONGO_USERNAME=natteradmin
MONGO_PASSWORD=natterpass123
DATABASE_URL="mongodb://natteradmin:natterpass123@localhost:27017/natter?authSource=admin&replicaSet=rs0&directConnection=true"
PORT=3000
BOT_MODE=false             # set to true to enable natterbot simulation
MONGO_SILENT_LOGS=true    # set to false to show verbose MongoDB logs in docker output
FILE_ORPHAN_TTL_HOURS=24  # uploads never sent in a message are deleted after this many hours
DEBUG_LOGS=true           # expose recent server logs at GET /debug/logs for the app's Diagnostics panel
